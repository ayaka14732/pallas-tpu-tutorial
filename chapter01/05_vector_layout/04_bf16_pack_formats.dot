digraph bf16_pack_formats {
    graph [bgcolor="white", pad=0.12, nodesep=0.6];
    node [shape=plain, fontname="Noto Sans CJK SC", fontsize=11];
    compact [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4"><TR><TD COLSPAN="3"><B>vpackc（Mosaic 的 TC VMEM 格式）</B></TD></TR><TR><TD></TD><TD>低 16 bit</TD><TD>高 16 bit</TD></TR><TR><TD WIDTH="70">sublane 0</TD><TD WIDTH="70">行 0</TD><TD WIDTH="70">行 1</TD></TR><TR><TD WIDTH="70">sublane 1</TD><TD WIDTH="70">行 2</TD><TD WIDTH="70">行 3</TD></TR><TR><TD WIDTH="70">sublane 2</TD><TD WIDTH="70">行 4</TD><TD WIDTH="70">行 5</TD></TR><TR><TD WIDTH="70">sublane 3</TD><TD WIDTH="70">行 6</TD><TD WIDTH="70">行 7</TD></TR><TR><TD WIDTH="70">sublane 4</TD><TD WIDTH="70">行 8</TD><TD WIDTH="70">行 9</TD></TR><TR><TD WIDTH="70">sublane 5</TD><TD WIDTH="70">行 10</TD><TD WIDTH="70">行 11</TD></TR><TR><TD WIDTH="70">sublane 6</TD><TD WIDTH="70">行 12</TD><TD WIDTH="70">行 13</TD></TR><TR><TD WIDTH="70">sublane 7</TD><TD WIDTH="70">行 14</TD><TD WIDTH="70">行 15</TD></TR></TABLE>>];
    interleaved [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4"><TR><TD COLSPAN="3"><B>vpack</B></TD></TR><TR><TD></TD><TD>低 16 bit</TD><TD>高 16 bit</TD></TR><TR><TD WIDTH="70">sublane 0</TD><TD WIDTH="70">行 0</TD><TD WIDTH="70">行 8</TD></TR><TR><TD WIDTH="70">sublane 1</TD><TD WIDTH="70">行 1</TD><TD WIDTH="70">行 9</TD></TR><TR><TD WIDTH="70">sublane 2</TD><TD WIDTH="70">行 2</TD><TD WIDTH="70">行 10</TD></TR><TR><TD WIDTH="70">sublane 3</TD><TD WIDTH="70">行 3</TD><TD WIDTH="70">行 11</TD></TR><TR><TD WIDTH="70">sublane 4</TD><TD WIDTH="70">行 4</TD><TD WIDTH="70">行 12</TD></TR><TR><TD WIDTH="70">sublane 5</TD><TD WIDTH="70">行 5</TD><TD WIDTH="70">行 13</TD></TR><TR><TD WIDTH="70">sublane 6</TD><TD WIDTH="70">行 6</TD><TD WIDTH="70">行 14</TD></TR><TR><TD WIDTH="70">sublane 7</TD><TD WIDTH="70">行 7</TD><TD WIDTH="70">行 15</TD></TR></TABLE>>];
}
